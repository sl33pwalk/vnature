def prepare_matugen():
    require("matugen")

    palette_template = (
        TEMPLATES
        / "palette.conf"
    )

    MATUGEN_CONFIG.write_text(
        "[config.wallpaper]\n"
        'command = "feh"\n'
        'arguments = ["--bg-fill"]\n'
        "set = false\n\n"
        "[templates.palette]\n"
        "input_path = "
        + toml_string(
            palette_template
        )
        + "\n"
        "output_path = "
        + toml_string(
            MATUGEN_PALETTE
        )
        + "\n",
        encoding="utf-8",
    )


def generate_palette(
    image,
    cfg,
    poh=False,
):
    prepare_matugen()

    MATUGEN_PALETTE.unlink(
        missing_ok=True
    )

    command = [
        "matugen",
        "-c",
        str(MATUGEN_CONFIG),

        "image",
        str(image),

        "-m",
        cfg["mode"],
    ]

    if poh:
        command += [
            "--source-color-index",
            "0",
        ]

    subprocess.run(
        command,
        check=True,
    )

    if not MATUGEN_PALETTE.is_file():
        raise VNatureError(
            "Matugen не создал palette"
        )

    return MATUGEN_PALETTE


def apply_image(
    image_argument,
    cfg,
    *,
    poh=False,
):
    image = expand(
        image_argument
    ).resolve()

    if not image.is_file():
        raise VNatureError(
            f"нет картинки: {image}"
        )

    palette = generate_palette(
        image,
        cfg,
        poh,
    )

    stage = build_stage(
        palette,

        name="__temporary__",

        wallpaper=image,

        kitty_mode=cfg[
            "kitty_mode"
        ],
    )

    commit_stage(
        stage
    )

    if DRY_RUN:
        return

    info(
        f"поставил: {image.name}"
    )

    print()
    print(
        "Чётко:"
    )
    print(
        "  vnature chotko NAME"
    )
    print(
        "  vnature chotko NAME --eblo"
    )

    print(
        "Говно:"
    )
    print(
        "  vnature govno"
    )


