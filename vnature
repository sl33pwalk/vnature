def window_pixels():
    # (колонки, строки, ширина и высота окна в пикселях) или None, если терминал не сказал.
    try:
        rows, cols, width, height = struct.unpack(
            "HHHH",
            fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8),
        )
    except OSError:
