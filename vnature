def render_template(
    template,
    values,
):
    if not template.is_file():
        return None

    text = template.read_text(
        encoding="utf-8"
    )

    for key, value in (
        values.items()
    ):
        text = text.replace(
            "{{"
            + key
            + "}}",
            value,
        )

    if (
        "{{" in text
        or "}}" in text
    ):
        raise VNatureError(
            f"в шаблоне "
            f"{template.name} "
            f"остались переменные"
        )

    return text


