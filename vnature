class VNatureError(Exception):
    pass


def info(text):
    print(f"vnature: {text}")


def warn(text):
    print(f"vnature: {text}", file=sys.stderr)


def toml_string(value):
    return json.dumps(str(value), ensure_ascii=False)


def expand(value):
    return Path(
        os.path.expandvars(
            os.path.expanduser(
                str(value)
            )
        )
    )


def ensure_dirs():
    for path in (
        PRESETS,
        CONFIG_DIR,
        STATE_DIR,
        CACHE,
        MATUGEN_DIR,
        GENERATED,
    ):
        path.mkdir(
            parents=True,
            exist_ok=True,
        )


def require(command):
    if shutil.which(command) is None:
        raise VNatureError(
            f"не найдена команда: {command}"
        )


