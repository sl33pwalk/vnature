def interactive_manage(cfg):

    presets = get_presets()

    selected = menu(
        "Управление пресетами",
        presets,
    )

    if selected is None:
        return

    name = presets[selected]

    action = menu(
        name,
        [
            "Режим Kitty",
            "Привязать текущие обои",
            "Убрать привязанные обои",
            "Удалить нахуй",
        ],
    )

    if action is None:
        return

    preset = load_preset(
        name
    )

    if action == 0:

        mode = (
            pick_kitty_mode(
                inherit=True,
            )
        )

        if mode:
            save_preset_meta(
                name,

                wallpaper=preset.get(
                    "wallpaper"
                ),

                kitty_mode=mode,
            )

    elif action == 1:

        wallpaper = (
            current_wallpaper()
        )

        if wallpaper:
            save_preset_meta(
                name,

                wallpaper=portable_wallpaper(
                    wallpaper,
                    cfg,
                ),

                kitty_mode=preset[
                    "kitty_mode"
                ],
            )

    elif action == 2:

        save_preset_meta(
            name,

            wallpaper=None,

            kitty_mode=preset[
                "kitty_mode"
            ],
        )

    elif action == 3:

        confirmation = menu(
            "Точно?",
            [
                "Нет",
                "Да, нахуй",
            ],
        )

        if confirmation == 1:
            remove_preset(
                name
            )

    pause()


def interactive_wallpaper(cfg):

    images = wallpaper_images(
        cfg[
            "wallpaper_dir"
        ]
    )

    index = menu(
        "Выбирай обои",
        [
            image.name
            for image in images
        ],
    )

    if index is None:
        return

    image = images[index]

    mode = menu(
        image.name,
        [
            "Выбрать source color",
            "Мне пох — бери первый",
        ],
    )

    if mode is None:
        return

    apply_image(
        str(image),
        cfg,
        poh=(
            mode == 1
        ),
    )

    pause()


def interactive_wallpaper_dir(cfg):

    print(
        "Папка обоев: "
        f"{cfg['wallpaper_dir']}"
    )

    raw = input(
        "Новая папка (пусто — оставить): "
    ).strip()

    if not raw:
        return

    images = wallpaper_images(
        expand(raw)
    )

    set_config_key(
        "wallpaper_dir",
        raw,
    )

    cfg[
        "wallpaper_dir"
    ] = expand(raw)

    info(
        f"папка обоев: {raw} "
        f"(картинок: {len(images)})"
    )

    pause()


def interactive(cfg):

    while True:

        try:
            if interactive_step(cfg) is False:
                return

        except VNatureError as error:
            warn(error)
            pause()

        except subprocess.CalledProcessError as error:
            warn(
                "команда упала "
                f"с кодом "
                f"{error.returncode}"
            )
            pause()


def interactive_step(cfg):

    action = menu(
        "VNature",
        [
            "Выбрать обои",
            "Применить тему",
            "Чётко — сохранить",
            "Говно — назад",
            "Управление пресетами",
            "Настройки Kitty",
            "Папка обоев",
            "Что сейчас",
            "Выйти",
        ],
    )

    if action is None:
        return False

    if action == 0:
        interactive_wallpaper(
            cfg
        )

    elif action == 1:
        interactive_apply(
            cfg
        )

    elif action == 2:
        interactive_save(
            cfg
        )

    elif action == 3:
        go_back()
        pause()

    elif action == 4:
        interactive_manage(
            cfg
        )

    elif action == 5:
        interactive_settings(
            cfg
        )

    elif action == 6:
        interactive_wallpaper_dir(
            cfg
        )

    elif action == 7:
        show_current()
        pause()

    elif action == 8:
        return False


