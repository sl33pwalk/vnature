def save_current(
    name,
    cfg,
    *,
    with_wallpaper=False,
    kitty_mode=None,
):
    if not name:
        raise VNatureError(
            "нужно имя"
        )

    palette = (
        CURRENT
        / "palette.conf"
    )

    if not palette.is_file():
        raise VNatureError(
            "текущей темы нет"
        )

    directory = (
        preset_path(name)
    )

    if DRY_RUN:
        info(
            f"dry-run: сохранил бы {directory}"
            + (
                " с текущими обоями"
                if with_wallpaper
                else ""
            )
        )
        return

    directory.mkdir(
        parents=True,
        exist_ok=True,
    )

    shutil.copy2(
        palette,
        directory
        / "palette.conf",
    )

    try:
        old = load_preset(
            name
        )
    except VNatureError:
        old = {
            "wallpaper": None,
            "kitty_mode": "inherit",
        }

    wallpaper_ref = old.get(
        "wallpaper"
    )

    if with_wallpaper:

        wallpaper = (
            current_wallpaper()
        )

        if not wallpaper:
            raise VNatureError(
                "не знаю текущие обои"
            )

        wallpaper_ref = (
            portable_wallpaper(
                wallpaper,
                cfg,
            )
        )

    selected_mode = (
        kitty_mode
        if kitty_mode is not None
        else old.get(
            "kitty_mode",
            "inherit",
        )
    )

    save_preset_meta(
        name,

        wallpaper=wallpaper_ref,

        kitty_mode=selected_mode,
    )

    info(
        f"чётко. сохранено: "
        f"{name}"
    )


def delete_preset(name):
    preset_path(name)

    if not preset_exists(name):
        raise VNatureError(
            f"такого пресета нет: "
            f"{name}"
        )

    if DRY_RUN:
        info(
            f"dry-run: удалил бы {preset_path(name)}"
        )
        return

    answer = input(
        f'Удалить "{name}"? [y/N]: '
    ).strip().lower()

    if answer not in (
        "y",
        "yes",
        "д",
        "да",
    ):
        info("не трогаю")
        return

    remove_preset(
        name
    )

    info(
        f"нахуй: {name}"
    )


