def obsidian_vaults():
    configs = [
        Path.home()
        / ".config"
        / "obsidian"
        / "obsidian.json",

        Path.home()
        / ".var"
        / "app"
        / "md.obsidian.Obsidian"
        / "config"
        / "obsidian"
        / "obsidian.json",
    ]

    result = []
    seen = set()

    for config in configs:

        if not config.is_file():
            continue

        try:
            raw = json.loads(
                config.read_text(
                    encoding="utf-8"
                )
            )
        except Exception as error:
            warn(
                "не могу прочитать "
                f"{config}: {error}"
            )
            continue

        vaults = raw.get(
            "vaults",
            {}
        )

        if not isinstance(
            vaults,
            dict,
        ):
            continue

        for entry in vaults.values():

            if not isinstance(
                entry,
                dict,
            ):
                continue

            raw_path = entry.get(
                "path"
            )

            if not raw_path:
                continue

            vault = Path(
                os.path.expandvars(
                    os.path.expanduser(
                        str(raw_path)
                    )
                )
            ).resolve()

            if not (
                vault.is_dir()
                and
                (vault / ".obsidian").is_dir()
            ):
                continue

            key = str(vault)

            if key in seen:
                continue

            seen.add(key)
            result.append(
                vault
            )

    return result


def sync_obsidian_theme(
    source,
):
    vaults = obsidian_vaults()

    if not vaults:
        warn(
            "Obsidian vault не найден"
        )
        return

    for vault in vaults:

        snippets = (
            vault
            / ".obsidian"
            / "snippets"
        )

        snippets.mkdir(
            parents=True,
            exist_ok=True,
        )

        target = (
            snippets
            / "vnature.css"
        )

        backup = (
            snippets
            / "vnature.css.before-vnature"
        )

        if (
            target.exists()
            and not backup.exists()
        ):
            shutil.copy2(
                target,
                backup,
            )

        temporary = (
            snippets
            / ".vnature.css.tmp"
        )

        shutil.copy2(
            source,
            temporary,
        )

        temporary.replace(
            target
        )

    info(
        "Obsidian: обновлено vault'ов: "
        + str(len(vaults))
    )


def render_apps(
    palette_file,
    kitty_mode,
    stage,
    base=STABLE,
):
    # Только рендер и проверка в stage/rendered, реальные файлы не трогаем.
    palette = read_palette(
        palette_file
    )

    missing = sorted(
        set(
            read_palette(
                TEMPLATES
                / "palette.conf"
            )
        )
        - set(palette)
    )

    if missing:
        raise VNatureError(
            f"в палитре {palette_file} "
            f"нет ключей: "
            + ", ".join(missing)
        )

    hypr = dict(
        palette
    )

    hypr["hypr_primary"] = (
        palette["primary"]
        .lstrip("#")
    )

    hypr["hypr_secondary"] = (
        palette["secondary"]
        .lstrip("#")
    )

    hypr["hypr_outline"] = (
        palette["outline"]
        .lstrip("#")
    )

    kitty = kitty_colors(
        palette,
        kitty_mode,
        base,
    )

    # шаблон, куда, папка приложения (None — пишем в кэш всегда), значения
    jobs = [
        ("polybar.ini", POLYBAR_GENERATED, None, palette),
        ("rofi.rasi", ROFI_GENERATED, None, palette),
        ("hyprland.lua", HYPRLAND_THEME, HYPRLAND_THEME.parent, hypr),
        ("swaync.css", SWAYNC_THEME, SWAYNC_THEME.parent, palette),
        ("waybar.css", WAYBAR_THEME, WAYBAR_THEME.parent, palette),
        ("obsidian.css", OBSIDIAN_GENERATED, None, palette),
        ("kitty.conf", KITTY_THEME, KITTY_THEME.parent, {**palette, **kitty}),
    ]

    rendered_dir = (
        stage
        / "rendered"
    )

    rendered_dir.mkdir(
        exist_ok=True,
    )

    rendered = {}

    for template_name, output, app_dir, values in jobs:

        text = render_template(
            TEMPLATES
            / template_name,

            values,
        )

        if text is None:
            continue

        staged = (
            rendered_dir
            / template_name
        )

        staged.write_text(
            text,
            encoding="utf-8",
        )

        rendered[template_name] = (
            staged,
            output,
            app_dir,
        )

    return rendered


def install_apps(rendered):
    installed = set()

    for template_name, (
        staged,
        output,
        app_dir,
    ) in rendered.items():

        if (
            app_dir is not None
            and not app_dir.is_dir()
        ):
            info(
                f"{app_dir.name}: нет "
                f"{app_dir}, пропускаю"
            )
            continue

        output.parent.mkdir(
            parents=True,
            exist_ok=True,
        )

        temporary = (
            output.parent
            / (
                "."
                + output.name
                + ".tmp"
            )
        )

        shutil.copyfile(
            staged,
            temporary,
        )

        temporary.replace(
            output
        )

        installed.add(
            template_name
        )

    if "obsidian.css" in installed:
        sync_obsidian_theme(
            OBSIDIAN_GENERATED
        )

    return (
        "polybar.ini" in installed,
        "kitty.conf" in installed,
    )


def reload_polybar():
    if (
        os.environ.get(
            "XDG_SESSION_TYPE"
        ) != "x11"
    ):
        return

    if not POLYBAR_LAUNCH.is_file():
        return

    subprocess.run(
        [
            "bash",
            str(POLYBAR_LAUNCH),
        ],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def reload_hyprland():
    if not os.environ.get(
        "HYPRLAND_INSTANCE_SIGNATURE"
    ):
        return

    if shutil.which("hyprctl") is None:
        return

    subprocess.run(
        [
            "hyprctl",
            "reload",
        ],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def reload_swaync():
    if shutil.which(
        "swaync-client"
    ) is None:
        return

    subprocess.run(
        [
            "swaync-client",
            "--reload-css",
            "--skip-wait",
        ],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def reload_kitty():
    # kitty >= 0.49 перечитывает kitty.conf вместе с include по SIGUSR1
    # (man kitty.conf). Сигналим только своим процессам с comm == kitty.
    for process in Path("/proc").iterdir():

        if not process.name.isdigit():
            continue

        try:
            if process.stat().st_uid != os.getuid():
                continue

            if (
                process / "comm"
            ).read_text().strip() != "kitty":
                continue

            os.kill(
                int(process.name),
                signal.SIGUSR1,
            )

        except OSError:
            continue


