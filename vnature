def valid_preset_name(name):
    return bool(
        name
        and not name.startswith(".")
        and "/" not in name
        and "\\" not in name
        and ".." not in name
    )


def preset_path(name):
    if not valid_preset_name(name):
        raise VNatureError(
            f"плохое имя пресета: {name!r}"
        )

    return PRESETS / name


def preset_exists(name):
    return (
        valid_preset_name(name)
        and
        (
            preset_path(name)
            / "palette.conf"
        ).is_file()
    )


def get_presets():
    if not PRESETS.exists():
        return []

    return sorted(
        directory.name
        for directory in PRESETS.iterdir()
        if (
            directory.is_dir()
            and valid_preset_name(directory.name)
            and
            (
                directory
                / "palette.conf"
            ).is_file()
        )
    )


def remove_preset(name):
    path = preset_path(name).resolve()

    # Симлинк или хитрое имя не должны увести rmtree за пределы presets/.
    if path.parent != PRESETS.resolve():
        raise VNatureError(
            f"пресет вне {PRESETS}: {path}"
        )

    if DRY_RUN:
        info(
            f"dry-run: удалил бы {path}"
        )
        return

    shutil.rmtree(path)


def load_preset(name):
    directory = preset_path(name)

    if not (
        directory
        / "palette.conf"
    ).is_file():
        raise VNatureError(
            f"такого пресета нет: {name}"
        )

    metadata = {
        "wallpaper": None,
        "kitty_mode": "inherit",
    }

    meta_file = (
        directory
        / "preset.toml"
    )

    if meta_file.is_file():
        try:
            with meta_file.open("rb") as f:
                raw = tomllib.load(f)
        except Exception as error:
            raise VNatureError(
                f"битый preset.toml "
                f"у {name}: {error}"
            )

        if raw.get("wallpaper"):
            metadata["wallpaper"] = str(
                raw["wallpaper"]
            )

        mode = str(
            raw.get(
                "kitty_mode",
                "inherit",
            )
        )

        if mode in (
            "inherit",
            "accent",
            "balanced",
            "full",
        ):
            metadata["kitty_mode"] = mode

    return metadata


def save_preset_meta(
    name,
    wallpaper=None,
    kitty_mode="inherit",
):
    if kitty_mode not in (
        "inherit",
        "accent",
        "balanced",
        "full",
    ):
        raise VNatureError(
            f"неизвестный kitty_mode: "
            f"{kitty_mode}"
        )

    directory = preset_path(name)

    lines = []

    if wallpaper:
        lines.append(
            "wallpaper = "
            + toml_string(wallpaper)
        )

    lines.append(
        "kitty_mode = "
        + toml_string(kitty_mode)
    )

    if DRY_RUN:
        info(
            f"dry-run: записал бы {directory / 'preset.toml'}: "
            + "; ".join(lines)
        )
        return

    (
        directory
        / "preset.toml"
    ).write_text(
        "\n".join(lines) + "\n",
        encoding="utf-8",
    )


def effective_kitty_mode(
    preset,
    cfg,
):
    mode = preset.get(
        "kitty_mode",
        "inherit",
    )

    if mode == "inherit":
        return cfg["kitty_mode"]

    return mode


