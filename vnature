def valid_preset_name(name):
    return bool(
        name
        and not name.startswith(".")
        and "/" not in name
        and "\\" not in name
        and ".." not in name
    )


def preset_path(name):
    if not valid_preset_name(name):
        raise VNatureError(
            f"плохое имя пресета: {name!r}"
        )

    return PRESETS / name


def preset_exists(name):
    return (
        valid_preset_name(name)
        and
        (
            preset_path(name)
            / "palette.conf"
        ).is_file()
    )


def get_presets():
    if not PRESETS.exists():
        return []

    return sorted(
        directory.name
        for directory in PRESETS.iterdir()
        if (
            directory.is_dir()
            and valid_preset_name(directory.name)
            and
            (
                directory
                / "palette.conf"
            ).is_file()
        )
    )


def remove_preset(name):
    path = preset_path(name).resolve()

    # Симлинк или хитрое имя не должны увести rmtree за пределы presets/.
    if path.parent != PRESETS.resolve():
        raise VNatureError(
            f"пресет вне {PRESETS}: {path}"
        )

    if DRY_RUN:
        info(
            f"dry-run: удалил бы {path}"
        )
        return

    shutil.rmtree(path)


def load_preset(name):
    directory = preset_path(name)

    if not (
        directory
        / "palette.conf"
    ).is_file():
        raise VNatureError(
            f"такого пресета нет: {name}"
        )

    metadata = {
        "wallpaper": None,
        "kitty_mode": "inherit",
    }

    meta_file = (
        directory
        / "preset.toml"
    )

    if meta_file.is_file():
        try:
            with meta_file.open("rb") as f:
                raw = tomllib.load(f)
        except Exception as error:
            raise VNatureError(
                f"битый preset.toml "
                f"у {name}: {error}"
            )

        if raw.get("wallpaper"):
            metadata["wallpaper"] = str(
                raw["wallpaper"]
            )

        mode = raw.get(
            "kitty_mode",
            "inherit",
        )

        if mode != "inherit":
            metadata["kitty_mode"] = normalize_kitty_mode(
                mode,
                "inherit",
            )

    return metadata


def save_preset_meta(
    name,
    wallpaper=None,
    kitty_mode="inherit",
):
    if kitty_mode != "inherit":
        if kitty_strength(kitty_mode) is None:
            raise VNatureError(
                f"неизвестный kitty_mode: "
                f"{kitty_mode}"
            )

        kitty_mode = normalize_kitty_mode(
            kitty_mode,
            None,
        )

    directory = preset_path(name)

    lines = []

    if wallpaper:
        lines.append(
            "wallpaper = "
            + toml_string(wallpaper)
        )

    lines.append(
        "kitty_mode = "
        + toml_value(kitty_mode)
    )

    if DRY_RUN:
        info(
            f"dry-run: записал бы {directory / 'preset.toml'}: "
            + "; ".join(lines)
        )
        return

    (
        directory
        / "preset.toml"
    ).write_text(
        "\n".join(lines) + "\n",
        encoding="utf-8",
    )


def effective_kitty_mode(
    preset,
    cfg,
):
    mode = preset.get(
        "kitty_mode",
        "inherit",
    )

    if mode == "inherit":
        return cfg["kitty_mode"]

    return mode


def kitty_strength(value):
    # Имя режима, целое 0–100 или строка "35"/"35%" -> 0–100 или "off".
    # None — значение непонятное.
    if isinstance(value, bool):
        return None

    if isinstance(value, str):
        if value in KITTY_MODES:
            point = KITTY_MODES[value][1]
            return "off" if point is None else point

        value = value.strip().removesuffix("%")

        if not value.isdigit():
            return None

        value = int(value)

    if isinstance(value, int) and 0 <= value <= 100:
        return value

    return None


def kitty_mode_value(strength):
    # Для хранения: точка шкалы -> её имя, иначе само число; "off" как есть.
    for name, (_, point) in KITTY_MODES.items():
        if point is not None and point == strength:
            return name

    return strength


def normalize_kitty_mode(value, default):
    strength = kitty_strength(value)

    if strength is None:
        return default

    return kitty_mode_value(strength)


def kitty_params(strength):
    # -> (surface, ansi) или None для off.
    if strength == "off":
        return None

    for point, surface, ansi in KITTY_CURVE:
        if strength == point:
            return surface, ansi

    for (low, s1, a1), (high, s2, a2) in zip(KITTY_CURVE, KITTY_CURVE[1:]):
        if low < strength < high:
            t = (strength - low) / (high - low)
            return s1 + (s2 - s1) * t, a1 + (a2 - a1) * t

    raise VNatureError(
        f"сила kitty вне шкалы: {strength}"
    )


def kitty_label(mode):
    # "inherit", "off", "50% (balanced)" или "35%"
    if mode == "inherit":
        return "inherit"

    strength = kitty_strength(mode)

    if strength in (None, "off"):
        return str(mode)

    name = kitty_mode_value(strength)

    return (
        f"{strength}% ({name})"
        if name != strength
        else f"{strength}%"
    )


