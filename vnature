def go_back():
    if not PREVIOUS.exists():
        raise VNatureError(
            "предыдущего говна нет"
        )

    state = read_state(
        PREVIOUS
    )

    palette = (
        PREVIOUS
        / "palette.conf"
    )

    wallpaper = (
        Path(state["wallpaper"])
        if state.get("wallpaper")
        else None
    )

    stage = Path(
        tempfile.mkdtemp(
            prefix="stage-",
            dir=CACHE,
        )
    )

    try:
        rendered = render_apps(
            palette,
            state["kitty_mode"],
            stage,
        )

        if DRY_RUN:
            dry_run_report(
                rendered,
                wallpaper,
            )
            return

        if (
            wallpaper
            and wallpaper.is_file()
        ):
            set_wallpaper(
                wallpaper
            )

        (
            polybar_changed,
            kitty_changed,
        ) = install_apps(
            rendered
        )

    finally:
        shutil.rmtree(
            stage,
            ignore_errors=True,
        )

    swap = (
        STATE_DIR
        / ".swap"
    )

    if swap.exists():
        shutil.rmtree(
            swap
        )

    if CURRENT.exists():
        CURRENT.rename(
            swap
        )

    PREVIOUS.rename(
        CURRENT
    )

    if swap.exists():
        swap.rename(
            PREVIOUS
        )

    if polybar_changed:
        reload_polybar()

    if kitty_changed:
        reload_kitty()

    reload_hyprland()
    reload_swaync()

    info(
        "вернул предыдущее говно"
    )


