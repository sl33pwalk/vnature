def pick_kitty_mode(
    inherit=True,
):
    modes = []

    if inherit:
        modes.append(
            (
                "Наследовать глобальный",
                "inherit",
            )
        )

    modes += [
        (
            label,
            mode,
        )
        for mode, (label, _)
        in KITTY_MODES.items()
    ]

    index = menu(
        "Режим Kitty",
        [
            label
            for label, _
            in modes
        ],
    )

    if index is None:
        return None

    return modes[index][1]


