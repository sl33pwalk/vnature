def build_stage(
    palette,
    *,
    name,
    wallpaper,
    kitty_mode,
):
    stage = Path(
        tempfile.mkdtemp(
            prefix="stage-",
            # dry-run не пишет даже во временные папки ~/.cache/vnature
            dir=None if DRY_RUN else CACHE,
        )
    )

    try:
        shutil.copy2(
            palette,
            stage / "palette.conf",
        )

        write_state(
            stage,
            name=name,
            wallpaper=wallpaper,
            kitty_mode=kitty_mode,
        )

    except BaseException:
        shutil.rmtree(
            stage,
            ignore_errors=True,
        )
        raise

    return stage


def dry_run_report(
    rendered,
    wallpaper,
):
    for staged, output, app_dir in (
        rendered.values()
    ):
        skip = (
            app_dir is not None
            and not app_dir.is_dir()
        )

        info(
            "dry-run: "
            + (
                "пропустил бы "
                if skip
                else "записал бы "
            )
            + str(output)
        )

    if "obsidian.css" in rendered:
        info(
            "dry-run: Obsidian vault'ы: "
            + (
                ", ".join(
                    map(str, obsidian_vaults())
                )
                or "нет"
            )
        )

    if wallpaper:
        info(
            f"dry-run: обои {wallpaper}"
        )

    info(
        "dry-run: ничего не записано"
    )


def commit_stage(stage, cfg):
    try:
        palette = (
            stage
            / "palette.conf"
        )

        state = read_state(
            stage
        )

        wallpaper = (
            Path(state["wallpaper"])
            if state.get("wallpaper")
            else None
        )

        if (
            wallpaper
            and not wallpaper.is_file()
        ):
            raise VNatureError(
                f"обои исчезли: "
                f"{wallpaper}"
            )

        rendered = render_apps(
            palette,
            state["kitty_mode"],
            stage,
            kitty_base(cfg),
        )

        if DRY_RUN:
            dry_run_report(
                rendered,
                wallpaper,
            )
            return

        # Обои до записи конфигов: если hyprpaper упадёт, конфиги целы.
        if wallpaper:
            set_wallpaper(
                wallpaper
            )

        (
            polybar_changed,
            kitty_changed,
        ) = install_apps(
            rendered
        )

        shutil.rmtree(
            stage
            / "rendered"
        )

        remember_current()

        if CURRENT.exists():
            shutil.rmtree(
                CURRENT
            )

        shutil.move(
            str(stage),
            str(CURRENT),
        )

    finally:
        if stage.exists():
            shutil.rmtree(
                stage,
                ignore_errors=True,
            )

    if polybar_changed:
        reload_polybar()

    if kitty_changed:
        reload_kitty()

    reload_hyprland()
    reload_swaync()


def apply_preset(
    name,
    cfg,
    *,
    with_wallpaper=False,
):
    preset = load_preset(
        name
    )

    palette = (
        preset_path(name)
        / "palette.conf"
    )

    wallpaper = (
        current_wallpaper()
    )

    if with_wallpaper:

        reference = preset.get(
            "wallpaper"
        )

        if not reference:
            info(
                f"у {name} нет "
                f"привязанных обоев"
            )

        else:
            candidate = (
                resolve_wallpaper(
                    reference,
                    cfg,
                )
            )

            if candidate.is_file():
                wallpaper = candidate

            else:
                warn(
                    "привязанные обои "
                    "не найдены: "
                    + str(candidate)
                )

    kitty_mode = (
        effective_kitty_mode(
            preset,
            cfg,
        )
    )

    stage = build_stage(
        palette,

        name=name,

        wallpaper=wallpaper,

        kitty_mode=kitty_mode,
    )

    commit_stage(
        stage,
        cfg,
    )

    if DRY_RUN:
        return

    info(
        f"применён пресет: "
        f"{name}"
    )


def current_kitty_target(
    state,
    cfg,
    preset_modes=None,
):
    # Какой kitty_mode должен быть у текущей темы при нынешних настройках.
    # None — темы нет или её пресет не найден: трогать нечего.
    # preset_modes: {имя: режим} поверх preset.toml (нужно для --dry-run).
    if state is None:
        return None

    name = state["name"]

    if name == "__temporary__":
        return cfg["kitty_mode"]

    if preset_modes and name in preset_modes:
        mode = preset_modes[name]

        if mode != "inherit":
            mode = normalize_kitty_mode(mode, None)

    elif preset_exists(name):
        mode = load_preset(name)["kitty_mode"]

    else:
        return None

    return effective_kitty_mode(
        {"kitty_mode": mode},
        cfg,
    )


def refresh_kitty(
    cfg,
    preset_modes=None,
    force=False,
):
    # После смены kitty_mode: перерендерить только kitty у текущей темы.
    # previous не трогаем, чтобы undo возвращал тему, а не режим kitty.
    state = (
        read_state(CURRENT)
        if (CURRENT / "palette.conf").is_file()
        else None
    )

    target = current_kitty_target(
        state,
        cfg,
        preset_modes,
    )

    if (
        target is None
        or (target == state["kitty_mode"] and not force)
    ):
        return "сохранено, применится при следующей теме"

    title = (
        "из картинки "
        + Path(state["wallpaper"] or "?").name
        if state["name"] == "__temporary__"
        else state["name"]
    )

    stage = Path(
        tempfile.mkdtemp(
            prefix="stage-",
            dir=None if DRY_RUN else CACHE,
        )
    )

    try:
        rendered = render_apps(
            CURRENT / "palette.conf",
            target,
            stage,
            kitty_base(cfg),
        )

        kitty_only = {
            "kitty.conf": rendered["kitty.conf"],
        }

        if DRY_RUN:
            dry_run_report(
                kitty_only,
                None,
            )
            return f"dry-run: применил бы kitty {target} к теме {title}"

        _, installed = install_apps(
            kitty_only
        )

    finally:
        shutil.rmtree(
            stage,
            ignore_errors=True,
        )

    write_state(
        CURRENT,
        name=state["name"],
        wallpaper=(
            Path(state["wallpaper"])
            if state.get("wallpaper")
            else None
        ),
        kitty_mode=target,
    )

    if not installed:
        return f"kitty {target} для темы {title}: kitty не найден, файл не записан"

    reload_kitty()

    return f"kitty {target} применён к теме {title}"


