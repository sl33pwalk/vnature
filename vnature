        if state.get("wallpaper")
        else None
    )

    stage = Path(
        tempfile.mkdtemp(
            prefix="stage-",
            # dry-run не пишет даже во временные папки ~/.cache/vnature
            dir=None if DRY_RUN else CACHE,
        )
    )

    try:
        rendered = render_apps(
            palette,
            state["kitty_mode"],
            stage,
            kitty_base(cfg),
        )

        if DRY_RUN:
            dry_run_report(
                rendered,
                wallpaper,
            )
            return

        if (
            wallpaper
            and wallpaper.is_file()
        ):
            set_wallpaper(
                wallpaper
            )

        (
            polybar_changed,
            kitty_changed,
        ) = install_apps(
            rendered
        )

    finally:
        shutil.rmtree(
            stage,
            ignore_errors=True,
        )

    swap = (
        STATE_DIR
        / ".swap"
    )

    if swap.exists():
        shutil.rmtree(
            swap
        )

    if CURRENT.exists():
        CURRENT.rename(
            swap
        )

    PREVIOUS.rename(
        CURRENT
    )

    if swap.exists():
        swap.rename(
            PREVIOUS
        )

    if polybar_changed:
        reload_polybar()

    if kitty_changed:
        reload_kitty()

    reload_hyprland()
    reload_swaync()

