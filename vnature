def save_current(
    name,
    cfg,
    *,
    with_wallpaper=False,
    kitty_mode=None,
):
    if not name:
        raise VNatureError(
            "нужно имя"
        )

    palette = (
        CURRENT
        / "palette.conf"
    )

    if not palette.is_file():
        raise VNatureError(
            "текущей темы нет"
        )

    directory = (
        preset_path(name)
    )

    if DRY_RUN:
        info(
            f"dry-run: сохранил бы {directory}"
            + (
