def menu(
    title,
    items,
):
    def run(stdscr):

        curses.curs_set(0)

        index = 0
        top = 0

        while True:

            stdscr.erase()

            height, width = (
                stdscr.getmaxyx()
            )

            if height < 6 or width < 20:
                # Меню не влезет: просим растянуть окно, ресайз перерисует.
                try:
                    stdscr.addnstr(
                        0,
                        0,
                        f"Окно маловато ({height}×{width}), "
                        "нужно хотя бы 6×20. q — выход",
                        max(1, width - 1),
                    )
                except curses.error:
                    pass

                if stdscr.getch() in (
                    27,
                    ord("q"),
                ):
                    return None

                continue

            # Строки под пункты: заголовок сверху, подсказка снизу.
            rows = max(
                1,
                height - 5,
            )

            if index < top:
                top = index

            elif index >= top + rows:
                top = index - rows + 1

            def put(y, text, attribute):
                if 0 <= y < height:
                    stdscr.addnstr(
                        y,
                        2,
                        text,
                        max(1, width - 3),
                        attribute,
                    )

            put(
                1,
                title,
                curses.A_BOLD,
            )

            if not items:
                put(
                    3,
                    "(пусто)",
                    curses.A_DIM,
                )

            for position in range(
                top,
                min(
                    len(items),
                    top + rows,
                ),
            ):

                marker = (
                    "❯ "
                    if position == index
                    else "  "
                )

                attribute = (
                    curses.A_REVERSE
                    if position == index
                    else curses.A_NORMAL
                )

                put(
                    3 + position - top,
                    marker + items[position],
                    attribute,
                )

            hint = (
                "↑/↓ j/k · "
                "Enter · q/Esc"
            )

            if len(items) > rows:
                hint += (
                    f" · {index + 1}/{len(items)}"
                )

            put(
                4 + min(
                    max(1, len(items)),
                    rows,
                ),
                hint,
                curses.A_DIM,
            )

            key = stdscr.getch()

            if not items:
                if key in (
                    10,
                    13,
                    27,
                    ord("q"),
                ):
                    return None

            elif key in (
                curses.KEY_UP,
                ord("k"),
            ):
                index = (
                    index - 1
                ) % len(items)

            elif key in (
                curses.KEY_DOWN,
                ord("j"),
            ):
                index = (
                    index + 1
                ) % len(items)

            elif key in (
                10,
                13,
            ):
                return index

            elif key in (
                27,
                ord("q"),
            ):
                return None

    return curses.wrapper(
        run
    )


