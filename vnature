def prepare_matugen(directory):
    require("matugen")

    palette_template = (
        TEMPLATES
        / "palette.conf"
    )

    (directory / "config.toml").write_text(
        "[config.wallpaper]\n"
        'command = "feh"\n'
        'arguments = ["--bg-fill"]\n'
        "set = false\n\n"
        "[templates.palette]\n"
        "input_path = "
        + toml_string(
            palette_template
        )
        + "\n"
        "output_path = "
        + toml_string(
            directory / "palette.conf"
        )
        + "\n",
        encoding="utf-8",
    )


def generate_palette(
    image,
    cfg,
    poh=False,
    directory=MATUGEN_DIR,
):
    prepare_matugen(directory)

    palette = directory / "palette.conf"

    palette.unlink(
        missing_ok=True
    )

    command = [
        "matugen",
        "-c",
        str(directory / "config.toml"),

        "image",
        str(image),

        "-m",
        cfg["mode"],
    ]

    if poh:
        command += [
            "--source-color-index",
            "0",
        ]

    # В TUI без вопросов matugen молчит: его вывод испортил бы экран curses.
    quiet = poh and SINK is not None

    result = subprocess.run(
        command,
        capture_output=quiet,
        text=True,
    )

    if result.returncode != 0:
        if quiet:
            raise VNatureError(
                f"matugen упал с кодом {result.returncode}: "
                + (result.stderr or result.stdout).strip()[-300:]
            )

        raise subprocess.CalledProcessError(
            result.returncode,
            command,
        )

    if not palette.is_file():
        raise VNatureError(
            "Matugen не создал palette"
        )

    return palette


def apply_image(
    image_argument,
    cfg,
    *,
    poh=False,
):
    image = expand(
        image_argument
    ).resolve()

    if not image.is_file():
        raise VNatureError(
            f"нет картинки: {image}"
        )

    matugen_dir = MATUGEN_DIR

    if DRY_RUN:
        matugen_dir = Path(
            tempfile.mkdtemp(
                prefix="vnature-matugen-",
            )
        )

        info(
            "dry-run: matugen всё равно запускается, "
            f"его конфиг и палитра — во временной {matugen_dir}"
        )

    try:
        palette = generate_palette(
            image,
            cfg,
            poh,
            matugen_dir,
        )

        stage = build_stage(
            palette,

            name="__temporary__",

            wallpaper=image,

            kitty_mode=cfg[
                "kitty_mode"
            ],
        )

        commit_stage(
            stage,
            cfg,
        )

    finally:
        if DRY_RUN:
            shutil.rmtree(
                matugen_dir,
                ignore_errors=True,
            )

    if DRY_RUN:
        return

    info(
        f"поставил: {image.name}"
    )

    if SINK is not None:
        return

    print()
    print(
        "Чётко:"
    )
    print(
        "  vnature chotko NAME"
    )
    print(
        "  vnature chotko NAME --eblo"
    )

    print(
        "Говно:"
    )
    print(
        "  vnature govno"
    )


