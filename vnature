def read_palette(path):
    result = {}

    for line in path.read_text(
        encoding="utf-8"
    ).splitlines():

        line = line.strip()

        if (
            not line
            or line.startswith("#")
            or "=" not in line
        ):
            continue

        key, value = (
            line.split("=", 1)
        )

        result[
            key.strip()
        ] = value.strip()

    return result


def hex_rgb(value):
    value = value.lstrip("#")

    return tuple(
        int(
            value[position:position + 2],
            16,
        )
        for position
        in (0, 2, 4)
    )


def rgb_hex(rgb):
    return (
        "#"
        + "".join(
            f"{max(0, min(255, round(v))):02x}"
            for v in rgb
        )
    )


def mix(a, b, amount):
    left = hex_rgb(a)
    right = hex_rgb(b)

    return rgb_hex(
        tuple(
            x * (1 - amount)
            + y * amount
            for x, y
            in zip(
                left,
                right,
            )
        )
    )


