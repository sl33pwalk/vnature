def build_stage(
    palette,
    *,
    name,
    wallpaper,
    kitty_mode,
):
    stage = Path(
        tempfile.mkdtemp(
            prefix="stage-",
            dir=CACHE,
        )
    )

    try:
        shutil.copy2(
            palette,
            stage / "palette.conf",
        )

        write_state(
            stage,
            name=name,
            wallpaper=wallpaper,
            kitty_mode=kitty_mode,
        )

    except BaseException:
        shutil.rmtree(
            stage,
            ignore_errors=True,
        )
        raise

    return stage


def dry_run_report(
    rendered,
    wallpaper,
):
    for staged, output, app_dir in (
        rendered.values()
    ):
        skip = (
            app_dir is not None
            and not app_dir.is_dir()
        )

        info(
            "dry-run: "
            + (
                "пропустил бы "
                if skip
                else "записал бы "
            )
            + str(output)
        )

    if "obsidian.css" in rendered:
        info(
            "dry-run: Obsidian vault'ы: "
            + (
                ", ".join(
                    map(str, obsidian_vaults())
                )
                or "нет"
            )
        )

    if wallpaper:
        info(
            f"dry-run: обои {wallpaper}"
        )

    info(
        "dry-run: ничего не записано"
    )


def commit_stage(stage):
    try:
        palette = (
            stage
            / "palette.conf"
        )

        state = read_state(
            stage
        )

        wallpaper = (
            Path(state["wallpaper"])
            if state.get("wallpaper")
            else None
        )

        if (
            wallpaper
            and not wallpaper.is_file()
        ):
            raise VNatureError(
                f"обои исчезли: "
                f"{wallpaper}"
            )

        rendered = render_apps(
            palette,
            state["kitty_mode"],
            stage,
        )

        if DRY_RUN:
            dry_run_report(
                rendered,
                wallpaper,
            )
            return

        # Обои до записи конфигов: если hyprpaper упадёт, конфиги целы.
        if wallpaper:
            set_wallpaper(
                wallpaper
            )

        (
            polybar_changed,
            kitty_changed,
        ) = install_apps(
            rendered
        )

        shutil.rmtree(
            stage
            / "rendered"
        )

        remember_current()

        if CURRENT.exists():
            shutil.rmtree(
                CURRENT
            )

        shutil.move(
            str(stage),
            str(CURRENT),
        )

    finally:
        if stage.exists():
            shutil.rmtree(
                stage,
                ignore_errors=True,
            )

    if polybar_changed:
        reload_polybar()

    if kitty_changed:
        reload_kitty()

    reload_hyprland()
    reload_swaync()


def apply_preset(
    name,
    cfg,
    *,
    with_wallpaper=False,
):
    preset = load_preset(
        name
    )

    palette = (
        preset_path(name)
        / "palette.conf"
    )

    wallpaper = (
        current_wallpaper()
    )

    if with_wallpaper:

        reference = preset.get(
            "wallpaper"
        )

        if not reference:
            info(
                f"у {name} нет "
                f"привязанных обоев"
            )

        else:
            candidate = (
                resolve_wallpaper(
                    reference,
                    cfg,
                )
            )

            if candidate.is_file():
                wallpaper = candidate

            else:
                warn(
                    "привязанные обои "
                    "не найдены: "
                    + str(candidate)
                )

    kitty_mode = (
        effective_kitty_mode(
            preset,
            cfg,
        )
    )

    stage = build_stage(
        palette,

        name=name,

        wallpaper=wallpaper,

        kitty_mode=kitty_mode,
    )

    commit_stage(
        stage
    )

    if DRY_RUN:
        return

    info(
        f"применён пресет: "
        f"{name}"
    )


