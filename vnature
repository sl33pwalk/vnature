# TUI
# ============================================================

def menu(
    title,
    items,
):
    def run(stdscr):

        curses.curs_set(0)

        index = 0
        top = 0

        while True:

            stdscr.erase()

            height, width = (
                stdscr.getmaxyx()
            )

            # Строки под пункты: заголовок сверху, подсказка снизу.
            rows = max(
                1,
                height - 5,
            )

            if index < top:
                top = index

            elif index >= top + rows:
                top = index - rows + 1

            def put(y, text, attribute):
                if 0 <= y < height:
                    stdscr.addnstr(
                        y,
                        2,
                        text,
                        max(1, width - 3),
                        attribute,
                    )

            put(
                1,
                title,
                curses.A_BOLD,
            )

            if not items:
                put(
                    3,
                    "(пусто)",
                    curses.A_DIM,
                )

            for position in range(
                top,
                min(
                    len(items),
                    top + rows,
                ),
            ):

                marker = (
                    "❯ "
                    if position == index
                    else "  "
                )

                attribute = (
                    curses.A_REVERSE
                    if position == index
                    else curses.A_NORMAL
                )

                put(
                    3 + position - top,
                    marker + items[position],
                    attribute,
                )

            hint = (
                "↑/↓ j/k · "
                "Enter · q/Esc"
            )

            if len(items) > rows:
                hint += (
                    f" · {index + 1}/{len(items)}"
                )

            put(
                4 + min(
                    max(1, len(items)),
                    rows,
                ),
                hint,
                curses.A_DIM,
            )

            key = stdscr.getch()

            if not items:
                if key in (
                    10,
                    13,
                    27,
                    ord("q"),
                ):
                    return None

            elif key in (
                curses.KEY_UP,
                ord("k"),
            ):
                index = (
                    index - 1
                ) % len(items)

            elif key in (
                curses.KEY_DOWN,
                ord("j"),
            ):
                index = (
                    index + 1
                ) % len(items)

            elif key in (
                10,
                13,
            ):
                return index

            elif key in (
                27,
                ord("q"),
            ):
                return None

    return curses.wrapper(
        run
    )


def pause():
    input(
        "\nEnter — дальше..."
    )


def pick_kitty_mode(
    inherit=True,
):
    modes = []

    if inherit:
        modes.append(
            (
                "Наследовать глобальный",
                "inherit",
            )
        )

    modes += [
        (
            "Accent — минимум изменений",
            "accent",
        ),
        (
            "Balanced — адаптивно",
            "balanced",
        ),
        (
            "Full — ебашим",
            "full",
        ),
    ]

    index = menu(
        "Режим Kitty",
        [
            label
            for label, _
            in modes
        ],
    )

    if index is None:
        return None

    return modes[index][1]


def interactive_apply(cfg):
    presets = get_presets()

    index = menu(
        "Какую тему?",
        presets,
    )

    if index is None:
        return

    name = presets[index]

    mode = menu(
        name,
        [
            "Только тема",
            "Тема + обои (--eblo)",
        ],
    )

    if mode is None:
        return

    apply_preset(
        name,
        cfg,
        with_wallpaper=(
            mode == 1
        ),
    )

    pause()


def interactive_save(cfg):
    name = input(
        "Имя пресета: "
    ).strip()

    if not name:
        return

    eblo = menu(
        "Привязать текущие обои?",
        [
            "Нет",
            "Да",
        ],
    )

    if eblo is None:
        return

    kitty_mode = (
        pick_kitty_mode(
            inherit=True,
        )
    )

    if kitty_mode is None:
        return

    save_current(
        name,
        cfg,
        with_wallpaper=(
            eblo == 1
        ),
        kitty_mode=kitty_mode,
    )

    pause()


def interactive_settings(cfg):

