def read_state(directory):
    meta = (
        directory
        / "state.toml"
    )

    if meta.is_file():
        with meta.open("rb") as f:
            raw = tomllib.load(f)

        return {
            "name": str(
                raw.get(
                    "name",
                    "unknown",
                )
            ),
            "wallpaper": (
                str(raw["wallpaper"])
                if raw.get("wallpaper")
                else None
            ),
            "kitty_mode": str(
                raw.get(
                    "kitty_mode",
                    "accent",
                )
            ),
        }

    # Совместимость с v0.1.
    if not directory.exists():
        return None

    old_name = directory / "name"
    old_wallpaper = (
        directory / "wallpaper"
    )

    return {
        "name": (
            old_name.read_text().strip()
            if old_name.is_file()
            else "unknown"
        ),
        "wallpaper": (
            old_wallpaper
            .read_text()
            .strip()
            if old_wallpaper.is_file()
            else None
        ),
        "kitty_mode": "accent",
    }


def write_state(
    directory,
    *,
    name,
    wallpaper,
    kitty_mode,
):
    lines = [
        "name = "
        + toml_string(name),

        "kitty_mode = "
        + toml_string(
            kitty_mode
        ),
    ]

    if wallpaper:
        lines.append(
            "wallpaper = "
            + toml_string(
                wallpaper.resolve()
            )
        )

    (
        directory
        / "state.toml"
    ).write_text(
        "\n".join(lines) + "\n",
        encoding="utf-8",
    )


def current_wallpaper():
    state = read_state(CURRENT)

    if not state:
        return None

    wallpaper = state.get(
        "wallpaper"
    )

    if not wallpaper:
        return None

    return Path(wallpaper)


def remember_current():
    if PREVIOUS.exists():
        shutil.rmtree(
            PREVIOUS
        )

    if CURRENT.exists():
        shutil.copytree(
            CURRENT,
            PREVIOUS,
        )


